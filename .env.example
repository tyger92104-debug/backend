# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://tyger1384:aauk7fg91e@cluster0.m8rmtqs.mongodb.net/urban_air_quality?retryWrites=true&w=majority

# API key that the ESP32 must send in the X-API-Key header
DEVICE_API_KEY=your-strong-secret-key-here

# Port the backend listens on (default: 3000)
PORT=3000

# Comma-separated list of allowed frontend origins, or * for all
# Example: http://localhost:5500,https://your-app.netlify.app
FRONTEND_URL=*

# Seconds without a reading before the device is considered offline
# ESP32 uploads every 10 s (UPLOAD_INTERVAL). Set to at least 3× that value.
OFFLINE_THRESHOLD_SECONDS=45
